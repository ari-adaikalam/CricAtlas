{
  "name": "cricatlas-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-duckdb.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "data": "node scripts/data-server.mjs",
    "verify": "npm run typecheck && npm test && node scripts/verify-browser.cjs",
    "verify:browser": "node scripts/verify-browser.cjs",
    "prebuild": "node scripts/build-addresses.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.29.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "next": "^16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.6-r.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.160.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "~5.9.0",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
